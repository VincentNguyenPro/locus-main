# Copier en .env  — ne jamais committer .env
# Défaut sûr pour la scène : fixtures. Passer à 0 pour brancher les MCP live.
USE_FIXTURES=1

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
MCP_BETA=mcp-client-2025-11-20

# FullEnrich (MCP + REST partagent le même token)
FULLENRICH_TOKEN=
FULLENRICH_MCP_URL=https://mcp.fullenrich.com/mcp

# Sillage (URL récupérée sur place à 9h)
SILLAGE_TOKEN=
SILLAGE_MCP_URL=

# Resend (envoi réel de l'email au clic « Envoyer » — multiplicateur optionnel)
RESEND_API_KEY=
RESEND_TO=
